{
  "id": "/#datavault6",
  "name": "DataVault6 - Centralized Dataset Platform",
  "short_name": "DataVault6",
  "description": "Unified multi-engine dataset management, intelligent routing, and real-time activity monitoring system.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B1329",
  "theme_color": "#0B1329",
